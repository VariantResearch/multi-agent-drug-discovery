{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
    "artifact_type": {
      "enum": [
        "run_manifest"
      ],
      "type": "string"
    },
    "budget": {
      "type": "object"
    },
    "declared_use": {
      "enum": [
        "research",
        "commercial"
      ],
      "type": "string"
    },
    "model_name": {
      "type": "string"
    },
    "model_version": {
      "type": "string"
    },
    "prompt_hash": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "tool_versions": {
      "type": "object"
    }
  },
  "required": [
    "artifact_type",
    "schema_version",
    "run_id",
    "model_name",
    "model_version",
    "prompt_hash"
  ],
  "type": "object"
}
